# ORMKit on macOS, the familiar way (gnustep-release-actions' macos.yml runs
# the same):
#
#   make -f Makefile.apple            ORMKit.framework, ORMRuntime.framework, ormtool
#                                     and ORMDesigner.app, universal (Release), and the
#                                     two frameworks as XCFrameworks (build/*.xcframework)
#   make -f Makefile.apple check      the Xcode project as .tools/genxcodeproj.py
#                                     writes it; the imports; the Debug builds;
#                                     both suites; ormtool on the StockMate model;
#                                     the fixture builders, and ormtool checking
#                                     what they write
#   make -f Makefile.apple install DESTDIR=<dir>       ORMDesigner.app, ORMKit.xcframework,
#                                                      ORMRuntime.xcframework and bin/ormtool
#                                                      (what an app pins: the release's
#                                                      ormkit-<v>-apple.zip)
#   make -f Makefile.apple installcheck DESTDIR=<dir>  the app's signature holds; ormtool
#                                                      runs where a build that pins ORMKit
#                                                      unpacks it (.deps/bin, beside the
#                                                      XCFrameworks, ODataKit's with them)
#
# bin/ormtool finds its frameworks beside it (its runpath search paths,
# .tools/genxcodeproj.py): ORMKit's and ORMRuntime's, and ODataKit's, which
# what pins ORMKit pins too (gnustep-release-actions' scripts/deps.sh apple
# unpacks both into .deps/).
#
# What it builds on (ODataKit's XCFrameworks, Sparkle's) is in .deps/, by the
# versions .github/pins.env names (gnustep-release-actions' scripts/deps.sh
# apple). GNUstep: GNUmakefile.

BUILD = build
DERIVED = $(BUILD)/DerivedData
RELEASE = $(DERIVED)/Build/Products/Release
DEBUG = $(abspath $(DERIVED)/Build/Products/Debug)
# Where a failed test's result bundle is kept (CI uploads it from there).
RESULTS ?= $(or $(RUNNER_TEMP),$(BUILD))
XCODEBUILD = xcodebuild -workspace ORMKit.xcworkspace -derivedDataPath $(DERIVED)

# The libraries an application builds on, as XCFrameworks: macOS, arm64 and
# x86_64, made from the Release frameworks.
FRAMEWORKS = ORMRuntime ORMKit

all:
	@test -d .deps/ODataKit.xcframework -a -d .deps/Sparkle.xcframework \
	  || { echo "no ODataKit or Sparkle in .deps: gnustep-release-actions' scripts/deps.sh apple fetches what .github/pins.env names"; exit 1; }
	@for scheme in ORMKit ormtool ORMDesigner; do \
	  $(XCODEBUILD) -scheme $$scheme -configuration Release -destination 'generic/platform=macOS' build || exit 1; \
	done
	@for fw in $(FRAMEWORKS); do \
	  rm -rf $(BUILD)/$$fw.xcframework; \
	  xcodebuild -create-xcframework -framework $(abspath $(RELEASE))/$$fw.framework \
	    -output $(BUILD)/$$fw.xcframework || exit 1; \
	done

check:
	python3 .tools/genxcodeproj.py
	git diff --exit-code -- ORMKit.xcodeproj ORMKit.xcworkspace \
	  || { echo "check: ORMKit.xcodeproj is stale: run python3 .tools/genxcodeproj.py and commit what it writes"; exit 1; }
	Scripts/check-imports.sh
	@for scheme in ORMKit ORMDesigner ormtool; do \
	  $(XCODEBUILD) -scheme $$scheme -configuration Debug -destination 'platform=macOS' build || exit 1; \
	done
	@for suite in ORMKitTests ORMDesignerTests; do \
	  rm -rf $(RESULTS)/$$suite.xcresult; \
	  $(XCODEBUILD) -scheme $$suite -destination 'platform=macOS' -resultBundlePath $(RESULTS)/$$suite.xcresult test || exit 1; \
	done
	DYLD_FRAMEWORK_PATH=$(DEBUG) Scripts/ormtool-smoke.sh $(DEBUG)/ormtool
	@mkdir -p $(BUILD)/fixtures/samples
	@for tool in workmate halpin; do \
	  clang -fobjc-arc -fmodules -F$(DEBUG) -framework ORMKit -framework ORMRuntime -Wl,-rpath,$(DEBUG) \
	    Tools/fixtures/$$tool.m -o $(BUILD)/fixtures/$$tool || exit 1; \
	done
	$(BUILD)/fixtures/workmate $(BUILD)/fixtures/WorkMate.orm
	$(BUILD)/fixtures/halpin $(BUILD)/fixtures/samples
	@for f in $(BUILD)/fixtures/WorkMate.orm $(BUILD)/fixtures/samples/*.orm; do \
	  DYLD_FRAMEWORK_PATH=$(DEBUG) $(DEBUG)/ormtool check "$$f" || exit 1; \
	done

install: all
	@test -n "$(DESTDIR)" || { echo "install: give DESTDIR"; exit 1; }
	mkdir -p $(DESTDIR)
	rm -rf $(DESTDIR)/ORMDesigner.app
	ditto $(RELEASE)/ORMDesigner.app $(DESTDIR)/ORMDesigner.app
	@for fw in $(FRAMEWORKS); do \
	  rm -rf $(DESTDIR)/$$fw.xcframework && ditto $(BUILD)/$$fw.xcframework $(DESTDIR)/$$fw.xcframework || exit 1; \
	done
	mkdir -p $(DESTDIR)/bin
	cp $(RELEASE)/ormtool $(DESTDIR)/bin/ormtool

# The app's signature; and ormtool run where a build that pins ORMKit unpacks
# it: .deps/bin beside ORMKit's XCFrameworks and ODataKit's.
installcheck:
	codesign --verify --deep --strict $(DESTDIR)/ORMDesigner.app
	@deps=$$(mktemp -d) && \
	  cp -R $(DESTDIR)/*.xcframework $(DESTDIR)/bin $$deps/ && \
	  cp -R .deps/ODataKit.xcframework .deps/ODataIncrementalStore.xcframework .deps/OTelKit.xcframework $$deps/ && \
	  $$deps/bin/ormtool check Samples/University.orm; status=$$?; rm -rf $$deps; exit $$status

clean:
	rm -rf $(BUILD)

.PHONY: all check install installcheck clean
