# What ORMKit builds on, by the exact versions of their releases:
# gnustep-release-actions' workflows (scripts/deps.sh) fetch them from here.
# To move one, edit it here.
#   Linux  each one's archive, unpacked into /opt/gnustep, the stack first
#   Apple  ODataKit's XCFrameworks and Sparkle's, unpacked into .deps/
#          (FreeCoreData has none: Apple's Core Data is the system's)

# The patched GNUstep stack (ashalkhakov/gnustep-patches).
GNUSTEP_PATCHES_VERSION=2026.10.20.52
# Core Data on GNUstep, with momc (ashalkhakov/FreeCoreData).
FREECOREDATA_VERSION=0.12.3
# HTTPServerKit's listener, which ODataKit's libraries link on GNUstep
# (ashalkhakov/GCDWebServer).
GCDWEBSERVER_VERSION=3.5.4.2
# ODataKit: ORMRuntime's OData requests, and the service the tests send
# them to (ashalkhakov/ODataKit).
ODATAKIT_VERSION=0.4.1
# ORMDesigner's updates on macOS.
SPARKLE_VERSION=2.10.0
# UDCode's SDK (ashalkhakov/UDCodeKit's udcodekit archives): what the ORM2
# extension builds on. The stack above is that UDCode release's, and
# DiagramKit below the one it carries: the extension uses UDCode's.
UDCODEKIT_VERSION=0.22.2
# ORMKit's diagrams: surfaces, SVG, layout and geometry; ORMDesigner's canvas
# (ashalkhakov/DiagramKit).
DIAGRAMKIT_VERSION=0.2.1
