<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="ORMAppDelegate">
            <connections>
                <outlet property="mainMenu" destination="mainMenu" id="mainMenuOutlet"/>
                <outlet property="sampleMenu" destination="openSampleMenu" id="sampleMenuOutlet"/>
                <outlet property="editMenu" destination="editMenu" id="editMenuOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <menu title="MainMenu" systemMenu="main" id="mainMenu">
            <items>
                <menuItem title="ORMDesigner" id="oRMDesignerMenuItem">
                    <menu key="submenu" title="ORMDesigner" systemMenu="apple" id="oRMDesignerMenu">
                        <items>
                            <menuItem title="About ORMDesigner" id="aboutORMDesigner">
                                <connections>
                                    <action selector="orderFrontStandardAboutPanel:" target="-3" id="aboutORMDesignerAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Check for Updates…" tag="1001" id="checkForUpdatesItem">
                                <connections>
                                    <action selector="checkForUpdates:" target="-2" id="checkForUpdatesAction"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="separator"/>
                            <menuItem title="Hide ORMDesigner" keyEquivalent="h" id="hideORMDesigner">
                                <connections>
                                    <action selector="hide:" target="-3" id="hideORMDesignerAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Quit ORMDesigner" keyEquivalent="q" id="quitORMDesigner">
                                <connections>
                                    <action selector="terminate:" target="-3" id="quitORMDesignerAction"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="File" id="fileMenuItem">
                    <menu key="submenu" title="File" id="fileMenu">
                        <items>
                            <menuItem title="New" keyEquivalent="n" id="new">
                                <connections>
                                    <action selector="newDocument:" target="-1" id="newAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Open…" keyEquivalent="o" id="open">
                                <connections>
                                    <action selector="openDocument:" target="-1" id="openAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Open Sample" id="openSample">
                                <menu key="submenu" title="Open Sample" id="openSampleMenu"/>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="separator2"/>
                            <menuItem title="Close" keyEquivalent="w" id="close">
                                <connections>
                                    <action selector="performClose:" target="-1" id="closeAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Save" keyEquivalent="s" id="save">
                                <connections>
                                    <action selector="saveDocument:" target="-1" id="saveAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Save As…" keyEquivalent="s" id="saveAs">
                                <modifierMask key="keyEquivalentModifierMask" command="YES" shift="YES"/>
                                <connections>
                                    <action selector="saveDocumentAs:" target="-1" id="saveAsAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Save a Copy for NORMA…" id="saveaCopyforNORMA">
                                <connections>
                                    <action selector="saveCopyForNorma:" target="-1" id="saveaCopyforNORMAAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Revert to Saved" id="reverttoSaved">
                                <connections>
                                    <action selector="revertDocumentToSaved:" target="-1" id="reverttoSavedAction"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="separator3"/>
                            <menuItem title="Export Diagram as PDF…" keyEquivalent="e" id="exportDiagramasPDF">
                                <modifierMask key="keyEquivalentModifierMask" command="YES" shift="YES"/>
                                <connections>
                                    <action selector="exportDiagramAsPDF:" target="-1" id="exportDiagramasPDFAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Export Diagram as PNG…" id="exportDiagramasPNG">
                                <connections>
                                    <action selector="exportDiagramAsPNG:" target="-1" id="exportDiagramasPNGAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Export Verbalization…" id="exportVerbalization">
                                <connections>
                                    <action selector="exportVerbalization:" target="-1" id="exportVerbalizationAction"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="separator4"/>
                            <menuItem title="Print…" keyEquivalent="p" id="print">
                                <connections>
                                    <action selector="printDocument:" target="-1" id="printAction"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Edit" id="editMenuItem">
                    <menu key="submenu" title="Edit" id="editMenu">
                        <items>
                            <menuItem title="Undo" keyEquivalent="z" id="undo">
                                <connections>
                                    <action selector="undo:" target="-1" id="undoAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Redo" keyEquivalent="z" id="redo">
                                <modifierMask key="keyEquivalentModifierMask" command="YES" shift="YES"/>
                                <connections>
                                    <action selector="redo:" target="-1" id="redoAction"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="separator5"/>
                            <menuItem title="Cut" keyEquivalent="x" id="cut">
                                <connections>
                                    <action selector="cut:" target="-1" id="cutAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Copy" keyEquivalent="c" id="copy">
                                <connections>
                                    <action selector="copy:" target="-1" id="copyAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Paste" keyEquivalent="v" id="paste">
                                <connections>
                                    <action selector="paste:" target="-1" id="pasteAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Delete" id="delete">
                                <connections>
                                    <action selector="delete:" target="-1" id="deleteAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Remove from Diagram" id="removefromDiagram">
                                <string key="keyEquivalent" base64-UTF8="YES">
CA
</string>
                                <modifierMask key="keyEquivalentModifierMask" command="YES" shift="YES"/>
                                <connections>
                                    <action selector="removeFromDiagram:" target="-1" id="removefromDiagramAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Select All" keyEquivalent="a" id="selectAll">
                                <connections>
                                    <action selector="selectAll:" target="-1" id="selectAllAction"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Window" id="windowMenuItem">
                    <menu key="submenu" title="Window" systemMenu="window" id="windowsMenu">
                        <items>
                            <menuItem title="Minimize" keyEquivalent="m" id="minimize">
                                <connections>
                                    <action selector="performMiniaturize:" target="-1" id="minimizeAction"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Bring All to Front" id="bringAlltoFront">
                                <connections>
                                    <action selector="arrangeInFront:" target="-1" id="bringAlltoFrontAction"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
            <point key="canvasLocation" x="140" y="154"/>
        </menu>
    </objects>
</document>
